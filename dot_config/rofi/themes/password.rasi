@import "~/.config/rofi/matugen-colors.rasi"

* {
    font: "JetBrains Mono Nerd Font 11";
    text: @fg-col;
    shade-bg: @bg-alpha;
}

configuration {
    show-icons: false;
}

window {
    width: 380px;
    border-radius: 16px;
    background-color: @bg-alpha;
    border: 1px solid;
    border-color: @surface-alpha;
    location: center;
}

mainbox {
    orientation: vertical;
    children: [ "inputbar" ];
    background-color: transparent;
    padding: 16px;
}

inputbar {
    children: [ "textbox-icon", "entry" ];
    border-radius: 12px;
    background-color: @surface0;
    spacing: 0px;
    padding: 0px;
}

textbox-icon {
    expand: false;
    background-color: transparent;
    text-color: @grey;
    padding: 10px 4px 10px 14px;
    content: "󰌾 ";
}

entry {
    cursor: text;
    placeholder: "Password...";
    placeholder-color: @grey;
    border-radius: 0 12px 12px 0;
    background-color: transparent;
    text-color: @fg-col;
    padding: 10px 14px 10px 4px;
}
