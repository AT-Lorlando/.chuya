/* Grid Material - Matugen dynamic colors with NixOS-inspired layout */

configuration {
    modi:                       "drun,filebrowser,window";
    font:                       "JetBrains Mono Nerd Font 11";
    show-icons:                 true;
    display-drun:               "";
    display-window:             "";
    display-filebrowser:        "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    case-sensitive:             false;
}

@import "~/.config/rofi/matugen-colors.rasi"

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 600px;
    background-color: @bg-alpha;
    border: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    transparency: "real";
}

mainbox {
    background-color: transparent;
    children: [ input-area, listview ];
    orientation: horizontal;
    spacing: 20px;
    padding: 30px;
}

/* Left sidebar */
input-area {
    children: [ inputbar, mode-switcher, dummy ];
    background-color: transparent;
    orientation: vertical;
    expand: false;
    width: 220px;
    spacing: 15px;
}

/* Search bar */
inputbar {
    children: [ entry ];
    background-color: @surface-alpha;
    border-radius: 12px;
    padding: 10px;
    orientation: horizontal;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

entry {
    padding: 4px;
    text-color: @fg-col;
    background-color: transparent;
    placeholder: "Search";
    placeholder-color: @grey;
    font: "JetBrains Mono Nerd Font Bold 11";
    horizontal-align: 0.0;
}

/* Mode switcher (tabs) */
mode-switcher {
    orientation: vertical;
    spacing: 8px;
    background-color: transparent;
}

button {
    padding: 12px;
    background-color: @surface-alpha;
    text-color: @grey;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    border-radius: 10px;
    cursor: pointer;
}

button selected {
    background-image: @tab-grad;
    text-color: @bg-col;
    border: 0px;
}

dummy {
    expand: true;
    background-color: transparent;
}

/* App grid */
listview {
    border: 0px;
    margin: 0px;
    padding: 0px;
    background-color: transparent;

    columns: 6;
    lines: 6;
    spacing: 12px;

    flow: horizontal;
    fixed-columns: true;
}

/* App card */
element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    padding: 15px 5px;
    spacing: 6px;

    background-color: transparent;
    border-radius: 14px;
    text-color: @fg-col;
    cursor: pointer;
    border: 1px;
    border-color: transparent;
}

element selected {
    background-image: @active-grad;
    text-color: @mauve;
    border: 1px;
    border-color: @mauve;
    border-radius: 14px;
}

element-icon {
    size: 42px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: inherit;
    font: "JetBrains Mono Nerd Font 10";
}

/* Error */
error-message {
    background-color: @bg-col;
    border: 1px;
    border-color: @fg-col2;
    border-radius: 12px;
    padding: 20px;
    text-color: @fg-col2;
}
