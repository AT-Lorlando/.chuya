@import "~/.config/rofi/matugen-colors.rasi"

* {
    font: "JetBrains Mono Nerd Font 11";
    text: @fg-col;
    shade-bg: @bg-alpha;
}

configuration {
    show-icons: false;
}

window {
    width: 580px;
    height: 360px;
    border-radius: 16px;
    background-color: @bg-alpha;
    border: 1px solid;
    border-color: @surface-alpha;
    location: center;
}

mainbox {
    orientation: vertical;
    children: [ "inputbar", "listview" ];
    background-color: transparent;
    spacing: 8px;
    padding: 16px;
}

inputbar {
    children: [ "textbox-icon", "entry" ];
    border-radius: 12px;
    background-color: @surface0;
    spacing: 0px;
    padding: 0px;
}

textbox-icon {
    expand: false;
    background-color: transparent;
    text-color: @grey;
    padding: 10px 4px 10px 14px;
    content: "󰒋 ";
}

entry {
    cursor: text;
    placeholder: "SSH to...";
    placeholder-color: @grey;
    border-radius: 0 12px 12px 0;
    background-color: transparent;
    text-color: @fg-col;
    padding: 10px 14px 10px 4px;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 5;
    cycle: false;
    dynamic: true;
    scrollbar: false;
    fixed-height: true;
    spacing: 2px;
    padding: 0px;
}

element {
    cursor: pointer;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg-col;
    padding: 10px 12px;
}

element selected {
    background-color: @surface0;
    text-color: @blue;
}

element-icon {
    background-color: transparent;
    size: 24px;
    padding: 0 8px 0 0;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: bold;
    horizontal-align: 0.0;
    vertical-align: 0.5;
}
